# Base Sepolia RPC endpoint (Alchemy, Infura, or the public one)
NEXT_PUBLIC_RPC_URL_BASE_SEPOLIA=https://sepolia.base.org

# WalletConnect Cloud project ID — required by RainbowKit, free at cloud.walletconnect.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Public URL this app is deployed at, used in the Farcaster manifest and cast text.
NEXT_PUBLIC_APP_URL=https://onchain-poaps.example.com
